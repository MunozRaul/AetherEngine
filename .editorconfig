[*.cs]
# --- Var Preferences ---
# Prefer explicit types over 'var' for built-in, framework, and apparent types
csharp_style_var_elsewhere = false:error
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error

# Elevate the preference (IDE0008) to a compiler warning or error
dotnet_diagnostic.IDE0008.severity = error

# --- Namespace Preferences ---
# Prefer file-scoped namespaces instead of block-scoped namespaces
csharp_style_namespace_declarations = file_scoped:error

# Elevate the preference (IDE0160) to a compiler warning or error
dotnet_diagnostic.IDE0160.severity = error